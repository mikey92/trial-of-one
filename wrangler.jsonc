{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trial-of-one",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Analysis results by photo hash (same photo, same answer, no second unit) and the daily budget.
  "kv_namespaces": [{ "binding": "CACHE", "id": "ffd9a970bafd49e4921f03de1e09ddec" }],
  "ratelimits": [
    // Photos per visitor per minute: a sitting is one photo, plus a retake or two.
    { "name": "ANALYZE_LIMIT", "namespace_id": "5101", "simple": { "limit": 6, "period": 60 } },
    // Weekly notes written by the model per visitor per minute; past this, the template writes them.
    { "name": "NOTE_LIMIT", "namespace_id": "5102", "simple": { "limit": 6, "period": 60 } }
  ],
  // Each HD analysis of 9-12 concerns costs 20 units. A small daily cap spreads what is left of the
  // hackathon's units over the judging weeks; the floor keeps one analysis in reserve.
  "vars": { "DAILY_ANALYSES": "3", "UNIT_FLOOR": "20" },
  "observability": { "enabled": true }
  // Secrets: YOUCAM_API_KEY, LLM_RELAY_URL, LLM_RELAY_KEY
}
